# Clé OpenRouter — https://openrouter.ai/keys
# Jamais dans le code, jamais dans l'image : ce fichier est lu à l'exécution.
OPENROUTER_API_KEY=

# Le « cerveau ». Tout modèle OpenRouter fait l'affaire.
LLM_MODEL=openai/gpt-4o

# STT. Simba-H (94M, CTC) est le seul de la famille à tenir le temps réel sans
# GPU. Pour tenter la précision supérieure au prix de la latence :
#   ASR_MODEL=UBC-NLP/Simba-M
#   ASR_ADAPTER=multilingual_african
# (Simba-M livre ses poids de tête dans adapter.<nom>.safetensors : sans
#  ASR_ADAPTER il transcrit n'importe quoi. Et comme l'image n'a préchargé que
#  Simba-H, le premier démarrage téléchargera 3,9 Go.)
# Simba-S et Simba-W sont des seq2seq de 1,5 à 2,3 Md : inutilisables ici.
ASR_MODEL=UBC-NLP/Simba-H
ASR_ADAPTER=

# TTS lingala (VITS mono-locuteur, 16 kHz).
TTS_MODEL=UBC-NLP/Simba-TTS-lin

# Découpage des tours de parole.
VAD_AGGRESSIVENESS=2
SILENCE_MS=700
MIN_SPEECH_MS=300
MAX_TURN_S=30

# 8 vCPU : 2 conversations x 3 threads torch = 6, il reste 2 vCPU pour le
# réseau et l'event loop. Les tours en trop attendent leur jeton.
MAX_CONCURRENT=2
TORCH_THREADS=3

LOG_LEVEL=INFO
